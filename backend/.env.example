# Copy to .env only if you need to change a default. The app runs with none of these set.

DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-before-deploying-anywhere
ENVIRONMENT=development
TIME_ZONE=Asia/Kolkata

# Postgres
DEFAULT_DATABASE_NAME=reckon_dev
DEFAULT_DATABASE_USER=postgres
DEFAULT_DATABASE_PASSWORD=
DEFAULT_DATABASE_HOST=localhost
DEFAULT_DATABASE_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Set True to run tasks inline and skip needing a Celery worker at all
CELERY_TASK_ALWAYS_EAGER=False

# AI. "fake" needs no key and no network — that is the default on purpose.
# Switch to "anthropic" and set a key when you want real answers.
AI_PROVIDER=fake
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Production only
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=
